# ==========================================================
# CẤU HÌNH HỆ THỐNG QUẢN LÝ HÓA ĐƠN ĐIỆN NƯỚC CÓ TÍCH HỢP AI
# ==========================================================

# 1. Cấu hình chung
PROJECT_NAME="Hệ thống quản lý hóa đơn điện nước có tích hợp AI"
ENVIRONMENT=development
DEBUG=True

# 2. Bảo mật & JWT
SECRET_KEY=super-secret-jwt-key-change-in-production-2026-dien-nuoc-ai
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. Cơ sở dữ liệu
# Ưu tiên PostgreSQL theo đặc tả:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/dien_nuoc_db
# Nếu chưa cài PostgreSQL, hệ thống tự động fallback về SQLite chạy ngay lập tức:
DATABASE_URL=sqlite:///./dien_nuoc.db

# 4. Cấu hình AI Service (Hỗ trợ: gemini, openai, ollama, mock)
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=15

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (Local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# 5. CORS Frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
